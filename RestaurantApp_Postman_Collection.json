{
  "info": {
    "_postman_id": "b1c2d3e4-f5a6-47b8-98c0-1a2b3c4d5e6f",
    "name": "RestaurantApp API (Firebase Firestore Only)",
    "description": "Complete Postman test suite for the RestaurantApp Node.js/Express backend running on Port 5050 with Firebase Firestore. Covers Health, Auth, Menu CRUD, Tables, Orders, and Reservations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5050/api",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "managerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "sampleMenuItemId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sampleOrderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sampleReservationId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System Health",
      "item": [
        {
          "name": "GET /health - Check Server & Firestore Status",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "POST /auth/register - Register Customer (Success 201)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Customer\",\n  \"email\": \"alice.customer@restaurant.test\",\n  \"password\": \"CustomerPass123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "POST /auth/register - Duplicate Email (Conflict 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Duplicate\",\n  \"email\": \"alice.customer@restaurant.test\",\n  \"password\": \"CustomerPass123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "POST /auth/login - Customer Login (Success 200)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@restaurant.local\",\n  \"password\": \"Customer123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "POST /auth/login - Manager Login (Success 200)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@restaurant.local\",\n  \"password\": \"Manager123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "POST /auth/login - Wrong Password (Failure 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@restaurant.local\",\n  \"password\": \"IncorrectPass!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "GET /auth/me - Authenticated Profile (200)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "GET /auth/me - Missing Token (Failure 401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "3. Menu Management",
      "item": [
        {
          "name": "GET /menu - List All Dishes (Public 200)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/menu", "host": ["{{baseUrl}}"], "path": ["menu"] }
          }
        },
        {
          "name": "GET /menu?category=Burgers - Filter by Category",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/menu?category=Burgers", "host": ["{{baseUrl}}"], "path": ["menu"], "query": [{ "key": "category", "value": "Burgers" }] }
          }
        },
        {
          "name": "GET /menu?search=Pizza - Search Dishes",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/menu?search=Pizza", "host": ["{{baseUrl}}"], "path": ["menu"], "query": [{ "key": "search", "value": "Pizza" }] }
          }
        },
        {
          "name": "GET /menu/categories - List Categories",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/menu/categories", "host": ["{{baseUrl}}"], "path": ["menu", "categories"] }
          }
        },
        {
          "name": "POST /menu - Manager Create Dish (Success 201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Artisan Truffle Burger\",\n  \"description\": \"Angus beef, black truffle aioli, aged gruyère on brioche\",\n  \"category\": \"Burgers\",\n  \"price\": 15.99,\n  \"emoji\": \"🍔\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/menu", "host": ["{{baseUrl}}"], "path": ["menu"] }
          }
        },
        {
          "name": "POST /menu - Customer Forbidden (Failure 403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Unauthorized Dish\",\n  \"description\": \"Should fail\",\n  \"category\": \"Burgers\",\n  \"price\": 10.00\n}"
            },
            "url": { "raw": "{{baseUrl}}/menu", "host": ["{{baseUrl}}"], "path": ["menu"] }
          }
        },
        {
          "name": "PUT /menu/:id - Manager Update Dish (Success 200)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 16.99\n}"
            },
            "url": { "raw": "{{baseUrl}}/menu/{{sampleMenuItemId}}", "host": ["{{baseUrl}}"], "path": ["menu", "{{sampleMenuItemId}}"] }
          }
        },
        {
          "name": "DELETE /menu/:id - Manager Delete Dish (Success 200)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": { "raw": "{{baseUrl}}/menu/{{sampleMenuItemId}}", "host": ["{{baseUrl}}"], "path": ["menu", "{{sampleMenuItemId}}"] }
          }
        }
      ]
    },
    {
      "name": "4. Tables",
      "item": [
        {
          "name": "GET /tables - List All Tables & Capacities (200)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/tables", "host": ["{{baseUrl}}"], "path": ["tables"] }
          }
        },
        {
          "name": "GET /tables/:tableNumber - Get Table Details (200)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/tables/1", "host": ["{{baseUrl}}"], "path": ["tables", "1"] }
          }
        }
      ]
    },
    {
      "name": "5. Orders",
      "item": [
        {
          "name": "POST /orders - Create Order (Calculated Server-Side 201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"menuItemId\": \"{{sampleMenuItemId}}\",\n      \"quantity\": 2\n    }\n  ],\n  \"notes\": \"No onions please\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
          }
        },
        {
          "name": "GET /orders/my - Customer View Own Orders (200)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/orders/my", "host": ["{{baseUrl}}"], "path": ["orders", "my"] }
          }
        },
        {
          "name": "GET /orders - Manager View All Orders (200)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
          }
        },
        {
          "name": "PATCH /orders/:id/status - Advance Status (Preparing)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Preparing\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/orders/{{sampleOrderId}}/status", "host": ["{{baseUrl}}"], "path": ["orders", "{{sampleOrderId}}", "status"] }
          }
        },
        {
          "name": "DELETE /orders/:id - Customer Cancel Pending Order",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/orders/{{sampleOrderId}}", "host": ["{{baseUrl}}"], "path": ["orders", "{{sampleOrderId}}"] }
          }
        }
      ]
    },
    {
      "name": "6. Reservations",
      "item": [
        {
          "name": "GET /reservations/availability - Check Availability",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/reservations/availability?date=2026-11-20&time=19:00",
              "host": ["{{baseUrl}}"],
              "path": ["reservations", "availability"],
              "query": [
                { "key": "date", "value": "2026-11-20" },
                { "key": "time", "value": "19:00" }
              ]
            }
          }
        },
        {
          "name": "POST /reservations - Book Table (Success 201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableNumber\": 3,\n  \"date\": \"2026-11-20\",\n  \"time\": \"19:00\",\n  \"partySize\": 4,\n  \"specialRequests\": \"Window view\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/reservations", "host": ["{{baseUrl}}"], "path": ["reservations"] }
          }
        },
        {
          "name": "POST /reservations - Conflict Overlapping Time (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableNumber\": 3,\n  \"date\": \"2026-11-20\",\n  \"time\": \"19:30\",\n  \"partySize\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/reservations", "host": ["{{baseUrl}}"], "path": ["reservations"] }
          }
        },
        {
          "name": "GET /reservations/my - Customer View Own Bookings (200)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/reservations/my", "host": ["{{baseUrl}}"], "path": ["reservations", "my"] }
          }
        },
        {
          "name": "PATCH /reservations/:id/status - Manager Accept Booking",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Confirmed\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/reservations/{{sampleReservationId}}/status", "host": ["{{baseUrl}}"], "path": ["reservations", "{{sampleReservationId}}", "status"] }
          }
        },
        {
          "name": "DELETE /reservations/:id - Customer Cancel Booking (200)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/reservations/{{sampleReservationId}}", "host": ["{{baseUrl}}"], "path": ["reservations", "{{sampleReservationId}}"] }
          }
        }
      ]
    }
  ]
}
